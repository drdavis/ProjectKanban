NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
# First owner: comma-separated email addresses, verified by Neon Auth.
# Existing product owners and explicitly assigned members also have access.
AUTH_ALLOWED_EMAILS=
DATABASE_URL=
DATABASE_URL_UNPOOLED=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Optional provider defaults for self-hosting.
PLANNER_AI_PROVIDER=openrouter
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Use openssl rand -hex 32 to enable encrypted per-user key storage.
AI_CREDENTIAL_ENCRYPTION_KEY=

# On Vercel, OIDC can authenticate the Gateway instead of a static API key.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-4.1-mini

# Optional OAuth pilot. Set both values before redeploying an existing OAuth-enabled instance.
MCP_OAUTH_RESOURCE=
MCP_OAUTH_PRODUCT=

# Optional owner-triggered invitation email delivery. Links work without this.
RESEND_API_KEY=
INVITATION_FROM_EMAIL=
